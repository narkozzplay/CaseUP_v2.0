# Local Docker/dev environment
SITE_BASE_URL=http://caseup.localhost:8000
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=GENERATE_NEW_DEV_SECRET_KEY
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,caseup.localhost,lib.caseup.localhost,.ngrok-free.dev,.ngrok-free.app
DJANGO_HEALTHCHECK_HOST=127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://caseup.localhost:8000,http://lib.caseup.localhost:8000,https://*.ngrok-free.dev,https://*.ngrok-free.app
DB_ENGINE=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=caseup_dev
POSTGRES_USER=caseup
POSTGRES_PASSWORD=caseup
POSTGRES_CONN_MAX_AGE=60
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
DJANGO_CACHE_URL=redis://redis:6379/1
DJANGO_LOG_LEVEL=INFO

# Encryption of API keys/bot tokens stored in the DB. Comma-separated Fernet keys: the first encrypts, all decrypt.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it with your backups: without it the stored keys cannot be decrypted. Empty = derived from DJANGO_SECRET_KEY.
FIELD_ENCRYPTION_KEYS=
SOCIAL_AUTH_REDIRECT_IS_HTTPS=0
RUN_MIGRATIONS=1
RUN_COLLECTSTATIC=1
DJANGO_PORT=8000
REDIS_PORT=6379
NGROK_AUTHTOKEN=YOUR_NGROK_TOKEN
COMPOSE_PROJECT_NAME=caseup_dev
APP_ENV_FILE=.env.dev
WEB_COMMAND=python manage.py runserver 0.0.0.0:8000

# Balance top-up (ЮKassa). Leave empty to use the fake "dev" checkout (works only with DEBUG=True).
# Test keys: yookassa.ru → личный кабинет → тестовый магазин → Интеграция → Ключи API (secret starts with test_).
# Webhook URL to set in the cabinet (HTTP-уведомления): https://<your-domain>/payments/webhook/yookassa/ , event payment.succeeded + payment.canceled
PAYMENTS_PROVIDER=auto
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENTS_TOPUP_MIN=50
PAYMENTS_TOPUP_MAX=100000
