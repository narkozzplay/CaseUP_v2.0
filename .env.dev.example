# Local Docker/dev environment
SITE_BASE_URL=http://caseup.localhost:8000
CASEUP_LAB_BASE_URL=http://lib.caseup.localhost:8000
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=GENERATE_NEW_DEV_SECRET_KEY
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,caseup.localhost,lib.caseup.localhost,.ngrok-free.dev,.ngrok-free.app
DJANGO_HEALTHCHECK_HOST=127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://caseup.localhost:8000,http://lib.caseup.localhost:8000,https://*.ngrok-free.dev,https://*.ngrok-free.app
DB_ENGINE=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=caseup_dev
POSTGRES_USER=caseup
POSTGRES_PASSWORD=caseup
POSTGRES_CONN_MAX_AGE=60
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
SOCIAL_AUTH_REDIRECT_IS_HTTPS=0
RUN_MIGRATIONS=1
RUN_COLLECTSTATIC=1
DJANGO_PORT=8000
REDIS_PORT=6379
NGROK_AUTHTOKEN=YOUR_NGROK_TOKEN
COMPOSE_PROJECT_NAME=caseup_dev
APP_ENV_FILE=.env.dev
WEB_COMMAND=python manage.py runserver 0.0.0.0:8000
