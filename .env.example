# Shared defaults loaded first by config/settings/base.py
# Local canonical split: site on caseup.localhost, lab/builder on lib.caseup.localhost.
SITE_BASE_URL=http://caseup.localhost:8000
CASEUP_LAB_BASE_URL=http://lib.caseup.localhost:8000
SOCIAL_AUTH_LOGIN_REDIRECT_URL=/profile/
SOCIAL_AUTH_NEW_USER_REDIRECT_URL=/profile/
SOCIAL_AUTH_LOGIN_ERROR_URL=/auth/login/
TELEGRAM_NOTIFICATIONS_ENABLED=0
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
FACEIT_API_KEY=YOUR_FACEIT_API_KEY
SOCIAL_AUTH_STEAM_API_KEY=YOUR_STEAM_WEB_API_KEY
STEAM_CATALOG_GRID_COLUMNS=7
BACKUP_DIR=backups
CELERY_TASK_TIME_LIMIT=1200
CELERY_TASK_SOFT_TIME_LIMIT=900
CELERY_RULE_RUNNING_STALE_SECONDS=3600
CELERY_BEAT_PRICE_UPDATE_SCHEDULER_SECONDS=300
CELERY_BEAT_PENDING_ALERT_DISPATCHER_SECONDS=120
CELERY_BEAT_STEAM_TRADING_UNLOCK_NOTIFIER_SECONDS=120

# Balance top-up (ЮKassa). Leave empty to use the fake "dev" checkout (works only with DEBUG=True).
# Test keys: yookassa.ru → личный кабинет → тестовый магазин → Интеграция → Ключи API (secret starts with test_).
# Webhook URL to set in the cabinet (HTTP-уведомления): https://<your-domain>/payments/webhook/yookassa/ , event payment.succeeded + payment.canceled
PAYMENTS_PROVIDER=auto
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENTS_TOPUP_MIN=50
PAYMENTS_TOPUP_MAX=100000

# Control Center → Логи: days to keep activity entries and raw HTTP-request entries.
ACTIVITY_LOG_RETENTION_DAYS=365
ACTIVITY_LOG_REQUEST_RETENTION_DAYS=90
