# Production environment
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_NEW_SECRET_KEY
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DB_ENGINE=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=caseup_prod
POSTGRES_USER=caseup
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_CONN_MAX_AGE=60
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
SOCIAL_AUTH_REDIRECT_IS_HTTPS=1
RUN_MIGRATIONS=1
RUN_COLLECTSTATIC=1
COMPOSE_PROJECT_NAME=caseup_prod
APP_ENV_FILE=.env.prod
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_SUPERUSER_PASSWORD
NGROK_AUTHTOKEN=
