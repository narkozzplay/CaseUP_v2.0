# Production environment. Step-by-step server setup: docs/DEPLOY.md
# Domain served by Caddy (HTTPS certificates are issued automatically for it, www. and lib.).
CADDY_DOMAIN=example.com
SITE_BASE_URL=https://example.com
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_NEW_SECRET_KEY
DJANGO_ALLOWED_HOSTS=example.com,www.example.com,lib.example.com
DJANGO_HEALTHCHECK_HOST=example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com,https://lib.example.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DB_ENGINE=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=caseup_prod
POSTGRES_USER=caseup
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_CONN_MAX_AGE=60
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
DJANGO_CACHE_URL=redis://redis:6379/1
DJANGO_LOG_LEVEL=INFO

# Encryption of API keys/bot tokens stored in the DB. Comma-separated Fernet keys: the first encrypts, all decrypt.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it with your backups: without it the stored keys cannot be decrypted. Empty = derived from DJANGO_SECRET_KEY.
FIELD_ENCRYPTION_KEYS=
# Steam sign-in and profile sync: key from https://steamcommunity.com/dev/apikey (domain = CADDY_DOMAIN).
SOCIAL_AUTH_STEAM_API_KEY=
SOCIAL_AUTH_REDIRECT_IS_HTTPS=1
RUN_MIGRATIONS=1
RUN_COLLECTSTATIC=1
COMPOSE_PROJECT_NAME=caseup_prod
APP_ENV_FILE=.env.prod
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_SUPERUSER_PASSWORD
NGROK_AUTHTOKEN=

# Balance top-up (ЮKassa). Leave empty to use the fake "dev" checkout (works only with DEBUG=True).
# Test keys: yookassa.ru → личный кабинет → тестовый магазин → Интеграция → Ключи API (secret starts with test_).
# Webhook URL to set in the cabinet (HTTP-уведомления): https://<your-domain>/payments/webhook/yookassa/ , event payment.succeeded + payment.canceled
PAYMENTS_PROVIDER=auto
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
FREEKASSA_MERCHANT_ID=
FREEKASSA_SECRET_1=
FREEKASSA_SECRET_2=
FREEKASSA_API_KEY=
FREEKASSA_TEST_MODE=0
PAYMENTS_TOPUP_MIN=50
PAYMENTS_TOPUP_MAX=100000

# Control Center → Логи: days to keep activity entries and raw HTTP-request entries.
ACTIVITY_LOG_RETENTION_DAYS=365
ACTIVITY_LOG_REQUEST_RETENTION_DAYS=90

# Outgoing mail: server errors and failed backups are mailed to ADMIN_EMAILS (docs/SERVER.md, section 7б).
# reg.ru hosting mailbox: host from the hosting panel (Почта → настройки почтового клиента), SSL port 465.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ADMIN_EMAILS=

# Daily backups at 04:15 (Celery). Copies stay here BACKUP_LOCAL_KEEP_DAYS days; with BACKUP_SFTP_* set they are
# also uploaded to the reg.ru hosting over SFTP and kept there BACKUP_REMOTE_KEEP_DAYS days (docs/SERVER.md, 7а).
# BACKUP_PROTOCOL: ftps (separate FTP user, port 21, recommended) or sftp (main hosting account, port 22).
BACKUP_PROTOCOL=ftps
BACKUP_LOCAL_KEEP_DAYS=7
BACKUP_REMOTE_KEEP_DAYS=30
BACKUP_SFTP_HOST=
BACKUP_SFTP_PORT=
BACKUP_SFTP_USER=
BACKUP_SFTP_PASSWORD=
BACKUP_SFTP_PATH=caseup-backups
BACKUP_SFTP_HOST_KEY=
