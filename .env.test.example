# Test environment
DJANGO_SETTINGS_MODULE=config.settings.testing
DJANGO_SECRET_KEY=GENERATE_NEW_TEST_SECRET_KEY
DB_ENGINE=sqlite
TEST_DB_ENGINE=postgres
TEST_POSTGRES_HOST=db
TEST_POSTGRES_PORT=5432
TEST_POSTGRES_DB=caseup_test
TEST_POSTGRES_USER=caseup
TEST_POSTGRES_PASSWORD=caseup
POSTGRES_CONN_MAX_AGE=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
RUN_MIGRATIONS=0
RUN_COLLECTSTATIC=0
